# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Load before launch, e.g.:  set -a; source .env; set +a; streamlit run app.py

# --- Data (optional; defaults to bundled ./demo_data) ---
VERIF_DATA_DIR=/path/to/forecasts          # directory of forecast NetCDF files
VERIF_OBS=/path/to/observations.nc         # gridded observation NetCDF

# --- Audit log location (optional; default ./logs/audit.jsonl) ---
VERIF_AUDIT=./logs/audit.jsonl

# --- Map boundary overlay (optional) ---
# Official boundary as GeoJSON or shapefile (.shp). If unset, falls back to
# Natural Earth (cartopy), which may not match official national boundaries.
VERIF_BOUNDARY=/path/to/India_official_boundary.shp

# --- Firebase / Firestore audit (optional; leave blank to disable) ---
VERIF_FIREBASE_CRED=/path/to/serviceAccountKey.json   # service-account JSON (from Firebase console)
VERIF_FIREBASE_COLLECTION=audit                        # Firestore collection name

# --- Security (optional but STRONGLY recommended for any shared deployment) ---
# Confine every path the sidebar will open to one directory tree. Unset means
# unrestricted, which is fine on a single-user desktop and is an arbitrary
# file-read primitive on a shared server. The bundled demo data and browser
# uploads stay readable regardless.
# VERIF_ROOT=/data/verification

# Maximum sub-directories a single folder scan will stat (default 500). Bounds
# the cost of someone pointing the sidebar at a huge directory such as "/".
# VERIF_MAX_SCAN_SUBDIRS=500

# --- Server (optional) ---
PORT=8501
